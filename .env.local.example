# ─── Frontend environment variables ──────────────────────────────────────────
# Copy this file to .env.local and fill in your Supabase project values.
# These NEXT_PUBLIC_ variables are safe to expose to the browser.

# Your Supabase project URL (from Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon / public key (from Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URL where the NestJS backend is running
NEXT_PUBLIC_API_URL=http://localhost:4000
